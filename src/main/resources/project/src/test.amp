@link "std.amp";

struct B {
    i32: itemB;
}
struct A {
    B[]: item0;
    u32: item1;
    i32: item2;
}

fn main () : i32 {
    u8[] : mem1 = stack_alloc<u8, 128>();
    u8[] : mem2 = stack_alloc<u8, 128>();
    {
        for (i32: i = 0; i < 128; i = i + 1) {
            mem1[i] = cast<u8>(0);
            mem2[i] = cast<u8>(0);
        }
    }

    A[] : item = cast<A[]>(mem1);
    item[0].item0 = cast<B[]>(mem2);
    item[0].item0[0].itemB = 77; // = B { itemB = 10 };

    compiler<?>("------------------------------------------------------------------");
    std::printf("a.item0[0].itemB = %d\n", item[0].item0[0].itemB);
    std::printf("a.item1 = %u\n", item[0].item1);
    std::printf("a.item2 = %d\n", item[0].item2);
    compiler<?>("------------------------------------------------------------------");
    
    item[0].item0[0].itemB = 32;
    item[0].item1 = 100u;
    item[0].item2 = 111;
    compiler<?>("------------------------------------------------------------------");
    
    std::printf("a.item0[0].itemB = %d\n", item[0].item0[0].itemB);
    std::printf("a.item1 = %u\n", item[0].item1);
    std::printf("a.item2 = %d\n", item[0].item2);

    ret 0;
}
