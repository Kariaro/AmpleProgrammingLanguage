@link "std.amp";
@link "compiler/compile.amp";
@link "compiler/lexer.amp";

struct B {
    i32: itemB;
}
struct A {
    B[]: item0;
    u32: item1;
    i32: item2;
    u8[]: text;
}

fn d_to_s_v(value : f64) {
    std::printf("%lf\n", value);
    ret;
}

