    let mem1 : u8[] = stack_alloc<u8, 128>();
    let mem2 : u8[] = stack_alloc<u8, 128>();
    {
        for (let i : i32 = 0; i < 128; i = i + 1) {
            mem1[i] = cast<u8>(0);
            mem2[i] = cast<u8>(0);
        }
    }
    
    let item : A[] = cast<A[]>(mem1);
    item[0].item0 = cast<B[]>(mem2);
    item[0].item0[0].itemB = 77; // = B { itemB = 10 };

    compiler<?>("------------------------------------------------------------------");
    std::printf("a.item0[0].itemB = %d\n", item[0].item0[0].itemB);
    std::printf("a.item1 = %u\n", item[0].item1);
    std::printf("a.item2 = %d\n", item[0].item2);
    compiler<?>("------------------------------------------------------------------");
    
    item[0].text = "Hello";
    item[1].text = ", World";
    item[2].text = ".";
    item[3].text = "!";
    for (let i : i32 = 0; i < 4; i = i + 1) {
        item[i].item2 = i;
        std::printf("item[%d].item2 = %d / [%s]\n", i, item[i].item2, item[i].text);
    }
    
    item[0].item0[0].itemB = 32;
    item[0].item1 = 100u;
    item[0].item2 = 111;
    compiler<?>("------------------------------------------------------------------");
    
    std::printf("a.item0[0].itemB = %d\n", item[0].item0[0].itemB);
    std::printf("a.item1 = %u\n", item[0].item1);
    std::printf("a.item2 = %d\n", item[0].item2);
    
    for (let i : i32 = 0; i < 32; i = i + 1) {
        std::printf("%d\n", i);
        std::printf("%p\n", sizeof(A) * cast<u64>(i) + cast<u64>(item));
        std::printf("%p\n", __builtin_address(item[i]));
        std::printf("%p\n", __builtin_address(item[i].item0));
        std::printf("%p\n", __builtin_address(item[i].item0[i]));
        std::printf("%p\n", __builtin_address(mem1[i]));
        std::printf("-------------------------------\n");
    }
    std::printf("%d\n", sizeof(A));

    // test_lexer();
    ctx::try_compile(1, "std.amp");

    ret 0;
