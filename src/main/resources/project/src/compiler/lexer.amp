@link "std.amp";

let EOF                : i32 /*(const)*/ = -1;
let WHITESPACE         : i32 /*(const)*/ = 0;
let IDENTIFIER         : i32 /*(const)*/ = 1;
let STRING             : i32 /*(const)*/ = 2;
let CHARACTER          : i32 /*(const)*/ = 3;
let NUM_U64            : i32 /*(const)*/ = 4;
let NUM_U32            : i32 /*(const)*/ = 5;
let NUM_I64            : i32 /*(const)*/ = 6;
let NUM_I32            : i32 /*(const)*/ = 7;
let VARARGS            : i32 /*(const)*/ = 8;
let DOT                : i32 /*(const)*/ = cast<i32>('.') + 10000;
let L_PARAM            : i32 /*(const)*/ = cast<i32>('(') + 10000;
let R_PARAM            : i32 /*(const)*/ = cast<i32>(')') + 10000;
let L_CURLY            : i32 /*(const)*/ = cast<i32>('{') + 10000;
let R_CURLY            : i32 /*(const)*/ = cast<i32>('}') + 10000;
let L_BRACK            : i32 /*(const)*/ = cast<i32>('[') + 10000;
let R_BRACK            : i32 /*(const)*/ = cast<i32>(']') + 10000;
let COLON              : i32 /*(const)*/ = cast<i32>(':') + 10000;
let SEMICOLON          : i32 /*(const)*/ = cast<i32>(';') + 10000;
let ASSIGN             : i32 /*(const)*/ = cast<i32>('=') + 10000;
let NOT                : i32 /*(const)*/ = cast<i32>('!') + 10000;
let NOR                : i32 /*(const)*/ = cast<i32>('~') + 10000;
let XOR                : i32 /*(const)*/ = cast<i32>('^') + 10000;
let AND                : i32 /*(const)*/ = cast<i32>('&') + 10000;
let OR                 : i32 /*(const)*/ = cast<i32>('|') + 10000;
let MINUS              : i32 /*(const)*/ = cast<i32>('-') + 10000;
let PLUS               : i32 /*(const)*/ = cast<i32>('+') + 10000;
let MUL                : i32 /*(const)*/ = cast<i32>('*') + 10000;
let DIV                : i32 /*(const)*/ = cast<i32>('/') + 10000;
let MOD                : i32 /*(const)*/ = cast<i32>('%') + 10000;
let LESS_THAN          : i32 /*(const)*/ = cast<i32>('<') + 10000;
let MORE_THAN          : i32 /*(const)*/ = cast<i32>('>') + 10000;
let COMMA              : i32 /*(const)*/ = cast<i32>(',') + 10000;
let NAMESPACE_OPERATOR : i32 /*(const)*/ = cast<i32>(':') + 256 * cast<i32>(':') + 10000;
let EQUALS             : i32 /*(const)*/ = cast<i32>('=') + 256 * cast<i32>('=') + 10000;
let NOT_EQUALS         : i32 /*(const)*/ = cast<i32>('!') + 256 * cast<i32>('=') + 10000;
let LESS_EQUAL         : i32 /*(const)*/ = cast<i32>('<') + 256 * cast<i32>('=') + 10000;
let MORE_EQUAL         : i32 /*(const)*/ = cast<i32>('>') + 256 * cast<i32>('=') + 10000;
let CAND               : i32 /*(const)*/ = cast<i32>('&') + 256 * cast<i32>('&') + 10000;
let COR                : i32 /*(const)*/ = cast<i32>('|') + 256 * cast<i32>('|') + 10000;
let SHIFT_LEFT         : i32 /*(const)*/ = cast<i32>('<') + 256 * cast<i32>('<') + 10000;
let SHIFT_RIGHT        : i32 /*(const)*/ = cast<i32>('>') + 256 * cast<i32>('>') + 10000;

// todo - how to share this across link objects?
struct token {
    u8[] : text;
    i32  : type;
}

fn (export) tokenize(buffer : u8[]) : token[] {
    // Get size of input buffer
    let buffer_size : u64 = cast<u64>(std::strlen(buffer));
    
    // There cannot be more tokens than the amount of characters in the buffer
    let malloc_size : u64 = (buffer_size + 1ul) * sizeof(token);
    let buffer_result : token[] = cast<token[]>(std::malloc(malloc_size)); //[buffer_size + 1ul];
    let text : u8[] = cast<u8[]>(std::malloc(0ul));

    let buffer_index : i32 = 0;
    let idx : i32 = 0;
    let last_idx : i32 = -1;
    while (cast<u64>(idx) < buffer_size) {
        if (last_idx == idx) {
            text = cast<u8[]>(std::malloc(2ul));
            text[0] = buffer[idx];
            text[1] = '\0';
            std::printf("[PREVENT FREEZE] at [%s] : %d\n", text, idx);
            break; // Prevent freeze
        }

        last_idx = idx;
        let char : u8 = buffer[idx];

        // White spaces
        if (char == '\t' || char == ' ' || char == '\n' || char == '\r') {
            let start : i32 = idx;
            while (char == '\t' || char == ' ' || char == '\n' || char == '\r') {
                idx = idx + 1;
                char = buffer[idx];
            }
            /*
            text = cast<u8[]>(std::malloc(cast<u64>(idx - start + 1)));
            for (let i : i32 = 0; i < idx - start; i = i + 1) {
                text[i] = buffer[start + i];
            }
            text[idx - start] = '\0';
            buffer_result[buffer_index].text = text;
            buffer_result[buffer_index].type = WHITESPACE;
            buffer_index = buffer_index + 1;
            */
            continue;
        }
        if (char == '/' && buffer[idx + 1] == '/') {
            let start : i32 = idx;
            while (char != '\r' && char != '\n' && char != '\0') {
                idx = idx + 1;
                char = buffer[idx];
            }
            /*
            text = cast<u8[]>(std::malloc(cast<u64>(idx - start + 1)));
            for (let i : i32 = 0; i < idx - start; i = i + 1) {
                text[i] = buffer[start + i];
            }
            text[idx - start] = '\0';
            buffer_result[buffer_index].text = text;
            buffer_result[buffer_index].type = WHITESPACE;
            buffer_index = buffer_index + 1;
            */
            continue;
        }
        if (char == '/' && buffer[idx + 1] == '*') {
            let start : i32 = idx;
            idx = idx + 3;
            while (buffer[idx] != '\0' && !(buffer[idx - 1] == '*' && buffer[idx] == '/')) {
                idx = idx + 1;
            }
            /*
            text = cast<u8[]>(std::malloc(cast<u64>(idx - start + 1)));
            for (let i : i32 = 0; i < idx - start; i = i + 1) {
                text[i] = buffer[start + i];
            }
            text[idx - start] = '\0';
            buffer_result[buffer_index].text = text;
            buffer_result[buffer_index].type = WHITESPACE;
            buffer_index = buffer_index + 1;
            */
            continue;
        }

        // Varargs
        if (char == '.' && cast<u64>(idx + 2) < buffer_size && buffer[idx + 1] == '.' && buffer[idx + 2] == '.') {
            buffer_result[buffer_index].text = "...";
            buffer_result[buffer_index].type = VARARGS;
            buffer_index = buffer_index + 1;
            idx = idx + 3;
            continue;
        }
        
        // if (char == '{') {
        //     buffer_result[buffer_index].text = "{";
        //     buffer_result[buffer_index].type = L_CURLY;
        //     buffer_index = buffer_index + 1;
        //     idx = idx + 1;
        //     continue;
        // }

        // todo - Could use pre allocated strings to not need allocation
        if (
            // single use
               char == '{' || char == '}'
            || char == '[' || char == ']'
            || char == '(' || char == ')'
            || char == '~' || char == '^'
            || char == '+' || char == '-'
            || char == '*' || char == '/'
            || char == '%' || char == ';'
            || char == ',' || char == '.'
            || char == '?'
    
            // possibly multibyte
            || char == '=' || char == '!'
            || char == '<' || char == '>'
            || char == '&' || char == '|'
            || char == ':'
        ) {
            idx = idx + 1;
            let next : u8 = buffer[idx];
            if ((char == '>' && next == '=')
            || (char == '>' && next == '>')
            || (char == '<' && next == '=')
            || (char == '<' && next == '<')
            || (char == '=' && next == '=')
            || (char == '!' && next == '=')
            || (char == '&' && next == '&')
            || (char == '|' && next == '|')
            || (char == ':' && next == ':')
            ) {
                 idx = idx + 1;
            } else {
                 next = '\0';
            }

            if (next != '\0') {
                text = cast<u8[]>(std::malloc(3ul));
                text[0] = char;
                text[1] = next;
                text[2] = '\0';
            } else {
                text = cast<u8[]>(std::malloc(2ul));
                text[0] = char;
                text[1] = '\0';
            }

            buffer_result[buffer_index].text = text;
            buffer_result[buffer_index].type = cast<i32>(char) + 256 * cast<i32>(next) + 10000;
            buffer_index = buffer_index + 1;
            continue;
        }
        
        // String
        if (char == '"') {
            let start : i32 = idx;
            idx = idx + 1;
            char = buffer[idx];
            while (char != '"') {
                if (char == '\\') {
                    let next : u8 = buffer[idx + 1];
                    if (next == '"'
                    || next == '\''
                    || next == 'r'
                    || next == 't'
                    || next == 'n'
                    || next == '0'
                    || next == '\\')
                    {
                        idx = idx + 1;
                    } else {
                        // todo - invalid escape????
                    }
                }
                idx = idx + 1;
                char = buffer[idx];
            }
            idx = idx + 1;
            text = cast<u8[]>(std::malloc(cast<u64>(idx - start + 1)));
            for (let i : i32 = 0; i < idx - start; i = i + 1) {
                text[i] = buffer[start + i];
            }
            text[idx - start] = '\0';
            buffer_result[buffer_index].text = text;
            buffer_result[buffer_index].type = STRING;
            buffer_index = buffer_index + 1;
            continue;
        }
        
        // Char
        if (char == '\'') {
            let start : i32 = idx;
            idx = idx + 1;
            char = buffer[idx];
            while (char != '\'') {
                if (char == '\\') {
                    let next : u8 = buffer[idx + 1];
                    if (next == '"'
                    || next == '\''
                    || next == 'r'
                    || next == 't'
                    || next == 'n'
                    || next == '0'
                    || next == '\\')
                    {
                        idx = idx + 1;
                    } else {
                        // todo - invalid escape????
                    }
                }
                idx = idx + 1;
                char = buffer[idx];
            }
            idx = idx + 1;
            text = cast<u8[]>(std::malloc(cast<u64>(idx - start + 1)));
            for (let i : i32 = 0; i < idx - start; i = i + 1) {
                text[i] = buffer[start + i];
            }
            text[idx - start] = '\0';
            buffer_result[buffer_index].text = text;
            buffer_result[buffer_index].type = CHARACTER;
            buffer_index = buffer_index + 1;
            continue;
        }
        
        // Identifier
        if ((char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z') || char == '_') {
            let start : i32 = idx;
            while ((char >= 'a' && char <= 'z') || (char >= 'A' && char <= 'Z') || char == '_' || (char >= '0' && char <= '9')) {
                idx = idx + 1;
                char = buffer[idx];
            }
            text = cast<u8[]>(std::malloc(cast<u64>(idx - start + 1)));
            for (let i : i32 = 0; i < idx - start; i = i + 1) {
                text[i] = buffer[start + i];
            }
            text[idx - start] = '\0';
            buffer_result[buffer_index].text = text;
            buffer_result[buffer_index].type = IDENTIFIER;
            buffer_index = buffer_index + 1;
            continue;
        }
        
        // Number
        if (char >= '0' && char <= '9') {
            let start : i32 = idx;
            // Hex
            if (buffer[idx + 1] == 'x') {
                idx = idx + 2;
                char = buffer[idx];
                while ((char >= 'a' && char <= 'f') || (char >= 'A' && char <= 'F') || (char >= '0' && char <= '9')) {
                    idx = idx + 1;
                    char = buffer[idx];
                }
                // todo - at least one match
            } else if (buffer[idx + 1] == 'b') {
                idx = idx + 2;
                char = buffer[idx];
                while (char == '0' || char == '1') {
                    idx = idx + 1;
                    char = buffer[idx];
                }
                // todo - at least one match
            } else {
                while (char >= '0' && char <= '9') {
                    idx = idx + 1;
                    char = buffer[idx];
                }
            }
            let type : i32 = NUM_I32;
            let next : u8 = buffer[idx];
            
            if (next == 'L' || next == 'l') {
                type = NUM_I64;
                idx = idx + 1;
            } else if (next == 'U' || next == 'u') {
                type = NUM_U32;
                idx = idx + 1;
                if (buffer[idx] == 'L' || buffer[idx] == 'l') {
                    type = NUM_U64;
                    idx = idx + 1;
                }
            }
            text = cast<u8[]>(std::malloc(cast<u64>(idx - start + 1)));
            for (let i : i32 = 0; i < idx - start; i = i + 1) {
                text[i] = buffer[start + i];
            }
            text[idx - start] = '\0';
            buffer_result[buffer_index].text = text;
            buffer_result[buffer_index].type = type;
            buffer_index = buffer_index + 1;
            continue;
        }
    }

    buffer_result[buffer_index].text = "";
    buffer_result[buffer_index].type = EOF;
    buffer_index = buffer_index + 1;
    ret buffer_result;
}

fn (export) test_lexer() : i32 {
    // Needed as heap does not in lang right now
    std::init_malloc(stack_alloc<u8, 100000>(), 100000l);

    let mem_start : u8[] = std::malloc(0ul);

    let test : u8[] = std::read_file("std.amp");
    let tokens : token[] = tokenize(test);
    
    let mem_end : u8[] = std::malloc(0ul);

    for (let i : i32 = 0; ; i = i + 1) {
        std::printf("TOKEN [value=\"%s\" type=%d]\n", tokens[i].text, tokens[i].type);
        if (tokens[i].type == -1) {
            break;
        }
    }

    std::printf("allocated -> %u\n", cast<u32>(cast<u64>(mem_end) - cast<u64>(mem_start)));
    ret 0;
}
